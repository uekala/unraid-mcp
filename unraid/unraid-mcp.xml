<?xml version="1.0"?>
<Container version="2">
  <Name>unraid-mcp</Name>
  <Repository>ghcr.io/uekala/unraid-mcp:latest</Repository>
  <Registry>https://github.com/uekala/unraid-mcp/pkgs/container/unraid-mcp</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/uekala/unraid-mcp</Support>
  <Project>https://github.com/uekala/unraid-mcp</Project>
  <Overview>MCP-Server für den Fernzugriff auf diesen Unraid-Server: Container auflisten, Protokolle lesen, starten/stoppen/neu starten, Appdata-Dateien lesen und ändern. Zugriff nur mit Bearer-Token.</Overview>
  <Category>Tools: Network:Management</Category>
  <WebUI/>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <Config Name="Port" Target="8765" Default="8765" Mode="tcp" Description="MCP unter /mcp, Gesundheit unter /gesund" Type="Port" Display="always" Required="true" Mask="false">8765</Config>
  <Config Name="MCP_TOKEN" Target="MCP_TOKEN" Default="" Mode="" Description="Mindestens 32 Zeichen, z. B. openssl rand -hex 32" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Docker-Socket" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="rw" Description="Steuerung der Container" Type="Path" Display="always" Required="true" Mask="false">/var/run/docker.sock</Config>
  <Config Name="Appdata" Target="/appdata" Default="/mnt/user/appdata" Mode="rw" Description="Lesen und schreiben" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata</Config>
  <Config Name="Container-Vorlagen" Target="/vorlagen" Default="/boot/config/plugins/dockerMan/templates-user" Mode="ro" Description="Unraid-Vorlagen, nur lesen" Type="Path" Display="always" Required="false" Mask="false">/boot/config/plugins/dockerMan/templates-user</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Berlin" Mode="" Description="Zeitzone" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Berlin</Config>
</Container>
